(security_headers) {
    header {
        # HSTS without includeSubDomains (in case a future subdomain isn't on HTTPS)
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }
}

monmouthaiteaching.com {
    import security_headers

    @aigames path /ai-games /ai-games/*
    handle @aigames {
        reverse_proxy ai-games:3000 {
            flush_interval -1
        }
    }

    @research path /research /research/*
    handle @research {
        uri strip_prefix /research
        reverse_proxy research-site-app-1:80 {
            flush_interval -1
        }
    }

    @cs215 path /cs215 /cs215/*
    handle @cs215 {
        reverse_proxy cs215-platform-app-1:3001 {
            flush_interval -1
        }
    }

    @bf422 path /bf422 /bf422/*
    handle @bf422 {
        reverse_proxy bf422-platform-app-1:3002 {
            flush_interval -1
        }
    }

    @aiqtest path /ai-iq-test /ai-iq-test/*
    handle @aiqtest {
        uri strip_prefix /ai-iq-test
        root * /srv/ai-iq-test
        file_server
    }

    @snhs path /snhs /snhs/*
    handle @snhs {
        uri strip_prefix /snhs
        root * /srv/snhs
        file_server
    }

    @cs310 path /cs310 /cs310/*
    handle @cs310 {
        uri strip_prefix /cs310
        reverse_proxy cs310-exercise-app:3000 {
            flush_interval -1
        }
    }

    handle {
        root * /srv/portal
        file_server
    }
}

